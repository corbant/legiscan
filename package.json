{
  "name": "@corbant/legiscan",
  "version": "0.4.0",
  "description": "TypeScript SDK for the Legiscan API",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "require": "./dist/cjs/index.js",
      "import": "./dist/esm/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./schemas/*": {
      "require": "./dist/cjs/schemas/*.js",
      "import": "./dist/esm/schemas/*.js",
      "types": "./dist/types/schemas/*.d.ts"
    }
  },
  "scripts": {
    "build:js": "node build.js",
    "build:types": "tsc",
    "build": "pnpm build:js && pnpm build:types",
    "lint": "eslint . --ext .ts,.js",
    "prepare": "pnpm build",
    "format": "prettier './**/*.{ts,js,json,md,yml,yaml}' --check",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "updateNocks": "tsx scripts/updateNocks.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corbant/legiscan.git"
  },
  "keywords": [
    "legiscan",
    "congress"
  ],
  "author": "coreyar",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/corbant/legiscan/issues"
  },
  "homepage": "https://github.com/corbant/legiscan#readme",
  "dependencies": {
    "camelize-ts": "^3.0.0"
  },
  "peerDependencies": {
    "zod": "^3.25.56"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.35.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.35.0",
    "globals": "^16.4.0",
    "jest": "^30.1.1",
    "nock": "^14.0.10",
    "prettier": "^3.2.5",
    "ts-jest": "^29.4.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "zod": "^4.1.7"
  },
  "resolutions": {
    "conventional-changelog-conventionalcommits": "8.0.0"
  },
  "packageManager": "pnpm@10.18.2",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
