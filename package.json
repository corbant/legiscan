{
  "name": "@just-buidl-it/legiscan",
  "version": "0.0.0",
  "description": "TypeScript SDK for the Legiscan API",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "unbuild",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write 'src/**/*.{ts,json,md,yml,yaml}'",
    "lint:commits": "commitlint --last --verbose",
    "release": "release-it",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "updateNocks": "tsx scripts/updateNocks.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/just-buidl-it/legiscan.git"
  },
  "keywords": [
    "legiscan",
    "congress"
  ],
  "author": "coreyar",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/just-buidl-it/legiscan/issues"
  },
  "homepage": "https://github.com/just-buidl-it/legiscan#readme",
  "dependencies": {
    "camelize-ts": "^3.0.0",
    "whatwg-fetch": "^3.6.20"
  },
  "peerDependencies": {
    "zod": "^3.25.56"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@release-it/conventional-changelog": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "eslint": "^8.57.0",
    "jest": "^30.1.1",
    "nock": "^14.0.10",
    "prettier": "^3.2.5",
    "release-it": "^19.0.3",
    "ts-jest": "^29.4.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "unbuild": "^3.5.0",
    "zod": "^4.1.7"
  },
  "resolutions": {
    "conventional-changelog-conventionalcommits": "8.0.0"
  },
  "packageManager": "yarn@1.22.19+sha1.4ba7fc5c6e704fce2066ecbfb0b0d8976fe62447",
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  }
}
